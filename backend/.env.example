# Local Twitch OAuth settings used by the backend. Replace only in backend/.env.
TWITCH_CLIENT_ID=replace-with-your-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-your-twitch-client-secret
TWITCH_OAUTH_REDIRECT_URI=http://localhost:8080/api/twitch/oauth/callback

# Public HTTPS URL (port 443) forwarded by your local tunnel to port 8080.
TWITCH_EVENTSUB_CALLBACK_URL=https://replace-with-your-public-host/api/twitch/eventsub/webhook
# Generate a private ASCII secret, for example: openssl rand -hex 32
TWITCH_EVENTSUB_SIGNING_SECRET=replace-with-a-generated-random-signing-secret
